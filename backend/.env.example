# Copy to .env for local development. Never commit .env.

# Local Postgres (see LOCAL_SETUP.md)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/docassist_dev"

# Any long random string locally; production reads it from Secret Manager.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Optional. Without it, AI suggestions are off; database suggestions still work.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Leave empty locally: uploads go to ./uploads. Production uses a Cloud Storage bucket.
GCS_BUCKET=""

# Optional comma-separated list of allowed web origins (mobile app needs none).
CORS_ORIGINS=""
